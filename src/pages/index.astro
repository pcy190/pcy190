---
import Base from '@/layouts/Base.astro';
import { avatar, awards, links, me, publications } from '@/data/profile';
---

<Base>
  <div class="doc page-foot">
    <section id="profile" class="section-lead">
      <img src={avatar} alt="Chaoyuan Peng" width="96" height="96" class="portrait" />
      <h1 class="profile-name">Chaoyuan Peng</h1>

      <p class="bio">
        Chaoyuan Peng is a Ph.D. student at Zhejiang University, under the supervision of{' '}
        <a href="https://yajin.org/" target="_blank" rel="noopener noreferrer">Yajin Zhou</a> and{' '}
        <a href="https://leiwu.org/" target="_blank" rel="noopener noreferrer">Lei Wu</a>. His
        interests span <strong>AI for security</strong>, systems security, browser security, and
        web3 security. He has uncovered more than 80 fixed vulnerabilities in Chrome, more than 30
        fixed vulnerabilities in AOSP, and several critical vulnerabilities in mainstream blockchain
        clients.
      </p>
      <p class="bio">
        He is currently a research intern at <strong>Qwen</strong>. Previously, he interned at
        BlockSec, Ant Group, and GOSSIP.
      </p>
      <p class="bio">
        He is an Ethereum Protocol Fellow (2024) and a former Vice-President of the ZJU Blockchain
        Association.
      </p>
    </section>

    <hr class="rule rule-gap" />
    <section id="publications" class="section">
      <div class="doc-row">
        <p class="doc-label">Publications</p>
        <ol class="entry-list">
          {
            publications.map((pub) => (
              <li>
                <h2 class="entry-title">{pub.title}</h2>
                <p class="entry-authors measure">
                  {pub.authors.map((author, i) => (
                    <Fragment>
                      {i > 0 ? ', ' : ''}
                      {author === me ? <strong class="entry-me">{author}</strong> : author}
                    </Fragment>
                  ))}
                </p>
                <p class="entry-meta">
                  {pub.venueShort} {pub.year}
                  {pub.link && (
                    <Fragment>
                      {' · '}
                      <a class="link-meta" href={pub.link} target="_blank" rel="noopener noreferrer">
                        Paper
                      </a>
                    </Fragment>
                  )}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <hr class="rule rule-gap" />
    <section class="section">
      <div class="doc-row">
        <p class="doc-label">Awards</p>
        <ul class="stack">
          {awards.map((award) => <li>{award}</li>)}
        </ul>
      </div>
    </section>

    <hr class="rule rule-gap" />
    <section id="contact" class="section">
      <div class="doc-row">
        <p class="doc-label">Contact</p>
        <dl class="deflist-mono">
          <div class="deflist-row">
            <dt class="deflist-term">Email</dt>
            <dd><a class="link-plain" href={`mailto:${links.email}`}>{links.email}</a></dd>
          </div>
          <div class="deflist-row">
            <dt class="deflist-term">Scholar</dt>
            <dd>
              <a class="link-plain" href={links.scholar} target="_blank" rel="noopener noreferrer">
                Google Scholar
              </a>
            </dd>
          </div>
          <div class="deflist-row">
            <dt class="deflist-term">X</dt>
            <dd>
              <a class="link-plain" href={links.x} target="_blank" rel="noopener noreferrer">@ret2happy</a>
            </dd>
          </div>
        </dl>
      </div>
    </section>
  </div>
</Base>
