---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import FindingsIndex from '@/components/FindingsIndex.astro';
import { formatDate, readingTime } from '@/utils/format';
import {
  avatar,
  awards,
  experience,
  findingGroups,
  links,
  publications,
  totalFindings,
} from '@/data/profile';

const interests = [
  { area: 'Systems security', detail: 'eBPF runtimes, OS kernels, trusted execution environments' },
  { area: 'Program analysis', detail: 'differential fuzzing, coverage-guided fuzzing, crash triage' },
  { area: 'Browser security', detail: 'Chrome renderer and browser-process vulnerabilities' },
  { area: 'Blockchain security', detail: 'smart contracts, DeFi protocol design flaws' },
];

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base>
  <div class="doc page-foot">
    <section id="profile" class="section-lead">
      <div class="doc-row">
        <div>
          <img src={avatar} alt="ret2happy" width="132" height="132" referrerpolicy="no-referrer" class="portrait" />
          <p class="doc-label portrait-label">Zhejiang University</p>
        </div>

        <div>
          <h1 class="profile-name">ret2happy</h1>
          <p class="profile-role">Ph.D. candidate · Computer security</p>

          <p class="thesis measure">
            I study how systems software fails under adversarial input, and build the tools that
            find those failures.
          </p>

          <div class="intro measure">
            <p class="note">
              My work covers kernel eBPF runtimes, browser engines, and smart contracts. Most of it
              combines differential and coverage-guided fuzzing with reading the code paths a fuzzer
              will not reach on its own.
            </p>
            <p class="note">
              Reports go to Google, the Android Security Team, and upstream maintainers. So far that
              is {totalFindings} CVEs and vendor-tracked bug IDs across {findingGroups.length} products.
            </p>
          </div>

          <div class="link-row">
            <a class="link-meta" href={links.scholar} target="_blank" rel="noopener noreferrer">Google Scholar</a>
            <a class="link-meta" href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a class="link-meta" href={links.x} target="_blank" rel="noopener noreferrer">X</a>
            <a class="link-meta" href={`mailto:${links.email}`}>{links.email}</a>
          </div>
        </div>
      </div>
    </section>

    <hr class="rule rule-gap" />
    <section class="section">
      <div class="doc-row">
        <p class="doc-label">Interests</p>
        <dl>
          {
            interests.map((item) => (
              <div class="deflist-row">
                <dt class="deflist-term">{item.area}</dt>
                <dd class="deflist-desc">{item.detail}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <hr class="rule rule-gap" />
    <section id="publications" class="section">
      <div class="doc-row">
        <p class="doc-label">Publications</p>
        <ol class="entry-list">
          {
            publications.map((pub) => (
              <li>
                <h2 class="entry-title measure">{pub.title}</h2>
                <p class="entry-meta">{pub.venueShort} {pub.year} · {pub.venue}</p>
                <p class="entry-links">
                  <a class="link-meta" href={pub.link} target="_blank" rel="noopener noreferrer">Paper</a>
                  {pub.codeLink && (
                    <a class="link-meta" href={pub.codeLink} target="_blank" rel="noopener noreferrer">Code</a>
                  )}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <hr class="rule rule-gap" />
    <section id="findings" class="section">
      <div class="doc-row">
        <p class="doc-label">Findings</p>
        <div>
          <p class="note measure">
            Vulnerabilities I reported that vendors have since fixed. Android issues use the
            internal tracker ID where no CVE was assigned.
          </p>
          <div class="intro">
            <FindingsIndex />
          </div>
        </div>
      </div>
    </section>

    <hr class="rule rule-gap" />
    <section class="section">
      <div class="doc-row">
        <p class="doc-label">Awards</p>
        <ul class="stack">
          {awards.map((award) => <li>{award}</li>)}
        </ul>
      </div>
    </section>

    <hr class="rule rule-gap" />
    <section id="about" class="section">
      <div class="doc-row">
        <p class="doc-label">Appointments</p>
        <ul class="stack stack-wide">
          {
            experience.map((item) => (
              <li>
                <span class="appt-org">{item.org}</span>
                <br />
                {item.role} · {item.focus}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <hr class="rule rule-gap" />
    <section id="writing" class="section">
      <div class="doc-row">
        <p class="doc-label">Writing</p>
        <div>
          {
            posts.length > 0 ? (
              <ul class="entry-list">
                {posts.map((post) => (
                  <li>
                    <a href={`/blog/${post.id}`}>
                      <h2 class="entry-title measure">{post.data.title}</h2>
                    </a>
                    <p class="entry-meta">
                      {formatDate(post.data.date)} · {readingTime(post.body ?? '')}
                    </p>
                    <p class="entry-note measure">{post.data.excerpt}</p>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="note">No posts yet.</p>
            )
          }
        </div>
      </div>
    </section>

    <hr class="rule rule-gap" />
    <section id="contact" class="section">
      <div class="doc-row">
        <p class="doc-label">Contact</p>
        <div>
          <p class="note measure">
            Email is the best way to reach me. I read every report, including the ones that turn out
            to be false positives.
          </p>
          <dl class="deflist-mono intro">
            <div class="deflist-row">
              <dt class="deflist-term">Email</dt>
              <dd><a class="link-plain" href={`mailto:${links.email}`}>{links.email}</a></dd>
            </div>
            <div class="deflist-row">
              <dt class="deflist-term">Scholar</dt>
              <dd>
                <a class="link-plain" href={links.scholar} target="_blank" rel="noopener noreferrer">
                  Google Scholar profile
                </a>
              </dd>
            </div>
            <div class="deflist-row">
              <dt class="deflist-term">Code</dt>
              <dd>
                <a class="link-plain" href={links.github} target="_blank" rel="noopener noreferrer">
                  github.com/ret2happy
                </a>
              </dd>
            </div>
            <div class="deflist-row">
              <dt class="deflist-term">X</dt>
              <dd>
                <a class="link-plain" href={links.x} target="_blank" rel="noopener noreferrer">@ret2happy</a>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
  </div>
</Base>
