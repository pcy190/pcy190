---
import Base from '@/layouts/Base.astro';
import { avatar, awards, experience, links, publications } from '@/data/profile';

const interests = [
  { area: 'Systems security', detail: 'eBPF runtimes, OS kernels, trusted execution environments' },
  { area: 'Program analysis', detail: 'differential fuzzing, coverage-guided fuzzing, crash triage' },
  { area: 'Browser security', detail: 'Chrome renderer and browser-process vulnerabilities' },
  { area: 'Blockchain security', detail: 'smart contracts, DeFi protocol design flaws' },
];
---

<Base>
  <div class="doc page-foot">
    <section id="profile" class="section-lead">
      <div class="doc-row">
        <div>
          <img src={avatar} alt="ret2happy" width="132" height="132" referrerpolicy="no-referrer" class="portrait" />
          <p class="doc-label portrait-label">Zhejiang University</p>
        </div>

        <div>
          <h1 class="profile-name">ret2happy</h1>

          <p class="motto">Attacks only get better.</p>

          <div class="link-row">
            <a class="link-meta" href={links.scholar} target="_blank" rel="noopener noreferrer">Google Scholar</a>
            <a class="link-meta" href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a class="link-meta" href={links.x} target="_blank" rel="noopener noreferrer">X</a>
            <a class="link-meta" href={`mailto:${links.email}`}>{links.email}</a>
          </div>
        </div>
      </div>
    </section>

    <hr class="rule rule-gap" />
    <section class="section">
      <div class="doc-row">
        <p class="doc-label">Interests</p>
        <dl>
          {
            interests.map((item) => (
              <div class="deflist-row">
                <dt class="deflist-term">{item.area}</dt>
                <dd class="deflist-desc">{item.detail}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <hr class="rule rule-gap" />
    <section id="publications" class="section">
      <div class="doc-row">
        <p class="doc-label">Publications</p>
        <ol class="entry-list">
          {
            publications.map((pub) => (
              <li>
                <h2 class="entry-title measure">{pub.title}</h2>
                <p class="entry-meta">{pub.venueShort} {pub.year} · {pub.venue}</p>
                <p class="entry-links">
                  <a class="link-meta" href={pub.link} target="_blank" rel="noopener noreferrer">Paper</a>
                  {pub.codeLink && (
                    <a class="link-meta" href={pub.codeLink} target="_blank" rel="noopener noreferrer">Code</a>
                  )}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <hr class="rule rule-gap" />
    <section class="section">
      <div class="doc-row">
        <p class="doc-label">Awards</p>
        <ul class="stack">
          {awards.map((award) => <li>{award}</li>)}
        </ul>
      </div>
    </section>

    <hr class="rule rule-gap" />
    <section id="about" class="section">
      <div class="doc-row">
        <p class="doc-label">Appointments</p>
        <ul class="stack stack-wide">
          {
            experience.map((item) => (
              <li>
                <span class="appt-org">{item.org}</span>
                <br />
                {item.role} · {item.focus}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <hr class="rule rule-gap" />
    <section id="contact" class="section">
      <div class="doc-row">
        <p class="doc-label">Contact</p>
        <dl class="deflist-mono">
          <div class="deflist-row">
            <dt class="deflist-term">Email</dt>
            <dd><a class="link-plain" href={`mailto:${links.email}`}>{links.email}</a></dd>
          </div>
          <div class="deflist-row">
            <dt class="deflist-term">Scholar</dt>
            <dd>
              <a class="link-plain" href={links.scholar} target="_blank" rel="noopener noreferrer">
                Google Scholar profile
              </a>
            </dd>
          </div>
          <div class="deflist-row">
            <dt class="deflist-term">X</dt>
            <dd>
              <a class="link-plain" href={links.x} target="_blank" rel="noopener noreferrer">@ret2happy</a>
            </dd>
          </div>
        </dl>
      </div>
    </section>
  </div>
</Base>
