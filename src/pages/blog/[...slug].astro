---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '@/layouts/Base.astro';
import { formatDate, readingTime } from '@/utils/format';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.excerpt}>
  <div class="doc section-lead page-foot">
    <div class="doc-row">
      <div>
        <a href="/#writing" class="link-meta">← All writing</a>
      </div>

      <article>
        <header>
          <h1 class="post-title measure">{post.data.title}</h1>
          <p class="entry-meta">
            {formatDate(post.data.date)} · {readingTime(post.body ?? '')} · {post.data.author}
          </p>
          {post.data.tags.length > 0 && <p class="post-tags">{post.data.tags.join(' · ')}</p>}
        </header>

        <hr class="rule rule-gap" />

        <div class="article intro">
          <Content />
        </div>
      </article>
    </div>
  </div>
</Base>
