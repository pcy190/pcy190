---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { formatDate, readingTime } from '@/utils/format';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base
  title="Writing"
  description="Notes on fuzzing, kernel and browser internals, and blockchain security."
>
  <div class="doc section-lead page-foot">
    <div class="doc-row">
      <p class="doc-label">Writing</p>

      <div>
        <p class="note measure">
          Notes on fuzzing, kernel and browser internals, and blockchain security. The longer
          results become papers. These are the rest.
        </p>

        {
          posts.length > 0 ? (
            <ul class="entry-list intro">
              {posts.map((post) => (
                <li>
                  <a href={`/blog/${post.id}`}>
                    <h2 class="entry-title measure">{post.data.title}</h2>
                  </a>
                  <p class="entry-meta">
                    {formatDate(post.data.date)} · {readingTime(post.body ?? '')}
                  </p>
                  <p class="entry-note measure">{post.data.excerpt}</p>
                </li>
              ))}
            </ul>
          ) : (
            <p class="note intro">No posts yet.</p>
          )
        }
      </div>
    </div>
  </div>
</Base>
