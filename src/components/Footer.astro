---
import { links } from '@/data/profile';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="doc site-footer-inner">
    <p class="site-footer-copy">© {year} ret2happy</p>

    <div class="site-footer-links">
      <a class="link-meta" href={links.scholar} target="_blank" rel="noopener noreferrer">Scholar</a>
      <a class="link-meta" href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="link-meta" href={links.x} target="_blank" rel="noopener noreferrer">X</a>
      <a class="link-meta" href={`mailto:${links.email}`}>Email</a>
    </div>
  </div>
</footer>
