---
import { findingGroups } from '@/data/profile';

const heavy = new Set(['Critical', 'High']);
---

<div class="index-groups">
  {
    findingGroups.map((group) => (
      <div>
        <div class="index-head">
          <h2 class="index-product">{group.product}</h2>
          <span class="index-rule" aria-hidden="true"></span>
          <span class="index-count">{group.findings.length}</span>
        </div>

        <ul class="index-ids">
          {group.findings.map((finding) => (
            <li class="index-id" data-weight={finding.severity && heavy.has(finding.severity) ? 'heavy' : undefined}>
              {finding.id}
              {finding.severity && <span class="index-sev">{finding.severity}</span>}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
