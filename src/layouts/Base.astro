---
import '@/styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Masthead from '@/components/Masthead.astro';
import { avatar, links } from '@/data/profile';

interface Props {
  title?: string;
  description?: string;
}

const defaultDescription =
  'Chaoyuan Peng is a Ph.D. student at Zhejiang University working on AI for security, web3 security, browser security, and systems security.';

const { title, description = defaultDescription } = Astro.props;
const pageTitle = title ? `${title} | ret2happy` : 'ret2happy';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(avatar, Astro.site);
const siteUrl = new URL('/', Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Chaoyuan Peng',
  alternateName: 'ret2happy',
  url: siteUrl.href,
  image: ogImage.href,
  jobTitle: 'Ph.D. Student',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Zhejiang University' },
  knowsAbout: [
    'AI for security',
    'Web3 security',
    'Browser security',
    'Systems security',
    'Fuzzing',
    'Vulnerability research',
  ],
  sameAs: [links.scholar, links.x],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Chaoyuan Peng" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/literata-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plex-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={avatar} />
    <link rel="apple-touch-icon" href={avatar} />
    <link rel="me" href={links.x} />
    <link rel="me" href={links.scholar} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="ret2happy" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Chaoyuan Peng" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@ret2happy" />
    <meta name="twitter:creator" content="@ret2happy" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
  </head>
  <body>
    <Masthead />
    <main>
      <slot />
    </main>
    <Analytics />
  </body>
</html>
